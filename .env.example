# Copy to .env.local for local work. On Vercel, set these in Project Settings, Environment Variables.

# Postgres connection string. The Vercel Neon integration sets this for you.
DATABASE_URL=

# Secret for /api/admin/*. Make a long random one: openssl rand -hex 32
ADMIN_TOKEN=

# Secret for /api/cron/tick. Vercel Cron sends it automatically when this variable exists.
CRON_SECRET=

# Optional. How often a busy site thinks for itself, in ms (default 300000 = 5 minutes, 0 = only the cron does it).
# HONE_TICK_EVERY_MS=300000
